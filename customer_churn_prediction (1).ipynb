      "source": [
        "# Model 1: Logistic Regression (baseline, interpretable)\n",
        "print(\"=\"*60)\n",
        "print(\"MODEL 1: Logistic Regression\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "lr_model = LogisticRegression(max_iter=1000, random_state=42)\n",
        "lr_model.fit(X_train, y_train)\n",
        "\n",
        "y_pred_lr = lr_model.predict(X_test)\n",
        "y_pred_lr_proba = lr_model.predict_proba(X_test)[:, 1]\n",
        "\n",
        "# Metrics\n",
        "lr_accuracy = accuracy_score(y_test, y_pred_lr)\n",
        "lr_precision = precision_score(y_test, y_pred_lr)\n",
        "lr_recall = recall_score(y_test, y_pred_lr)\n",
        "lr_f1 = f1_score(y_test, y_pred_lr)\n",
        "lr_auc = roc_auc_score(y_test, y_pred_lr_proba)\n",
        "\n",
        "print(f\"\\nAccuracy:  {lr_accuracy:.4f} (% of correct predictions)\")\n",
        "print(f\"Precision: {lr_precision:.4f} (of predicted churners, % actually churned)\")\n",
        "print(f\"Recall:    {lr_recall:.4f} (of actual churners, % we caught)\")\n",
        "print(f\"F1-Score:  {lr_f1:.4f} (balance of precision & recall)\")\n",
        "print(f\"AUC-ROC:   {lr_auc:.4f} (ability to separate classes)\")\n",
        "\n",
        "print(f\"\\nClassification Report:\")\n",
        "print(classification_report(y_test, y_pred_lr, target_names=['No Churn', 'Churn']))"
      ]
    },
