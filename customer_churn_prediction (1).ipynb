        "# Model 2: Random Forest (more sophisticated, non-linear)\n",
        "print(\"\\n\" + \"=\"*60)\n",
        "print(\"MODEL 2: Random Forest Classifier\")\n",
        "print(\"=\"*60)\n",
        "\n",
        "rf_model = RandomForestClassifier(\n",
        "    n_estimators=100,\n",
        "    max_depth=10,\n",
        "    min_samples_split=10,\n",
        "    random_state=42,\n",
        "    n_jobs=-1\n",
